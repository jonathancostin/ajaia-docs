{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "ajaia-docs",
	"main": "worker/index.ts",
	"compatibility_date": "2026-11-13",
	// Static files are served without running the Worker. Only /api/* reaches it.
	"assets": {
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api/*"]
	},
	"observability": { "enabled": true },
	"upload_source_maps": true,
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "ajaia-docs",
			"database_id": "bb5ae44b-0e60-4e95-afb6-21a193513997",
			"migrations_dir": "migrations"
		}
	],
	// One live room per document (worker/room.ts).
	"durable_objects": {
		"bindings": [{ "name": "DOCUMENT_ROOM", "class_name": "DocumentRoom" }]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["DocumentRoom"] }],
	// A separate copy with its own database, used to prove a risky change on
	// Cloudflare before it goes to the live site: CLOUDFLARE_ENV=staging npm run deploy
	"env": {
		"staging": {
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "ajaia-docs-staging",
					"database_id": "c9a97957-fd05-4360-af8b-309e9a821849",
					"migrations_dir": "migrations"
				}
			],
			"durable_objects": {
				"bindings": [{ "name": "DOCUMENT_ROOM", "class_name": "DocumentRoom" }]
			},
			"migrations": [{ "tag": "v1", "new_sqlite_classes": ["DocumentRoom"] }]
		}
	}
}
