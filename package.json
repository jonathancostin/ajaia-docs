{
  "name": "ajaia-docs",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3410",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "db:generate": "drizzle-kit generate",
    "db:local": "wrangler d1 migrations apply ajaia-docs --local",
    "db:remote": "wrangler d1 migrations apply ajaia-docs --remote",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query": "^5.107.1",
    "@tiptap/extensions": "^3.34.0",
    "@tiptap/html": "^3.34.0",
    "@tiptap/markdown": "^3.34.0",
    "@tiptap/pm": "^3.34.0",
    "@tiptap/react": "^3.34.0",
    "@tiptap/starter-kit": "^3.34.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.18",
    "lucide-react": "^1.72.0",
    "mammoth": "^1.13.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "tailwindcss": "^4.3.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.69.1",
    "@cloudflare/vitest-plugin": "^1.8.2",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^0.31.11",
    "happy-dom": "^21.0.4",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "wrangler": "^4.162.0"
  }
}
